# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
SERVER_CTX_PATH=/fintech-service

# ==============================================================================
# DATABASE (PostgreSQL / Supabase)
# ==============================================================================
DB_URL=jdbc:postgresql://your-db-host:5432/your_database_name
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# ==============================================================================
# OBJECT STORAGE (S3-compatible / Supabase Storage)
# ==============================================================================
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_REGION=ap-south-1
S3_KEY_ID=your_s3_access_key_id
S3_ACCESS_KEY=your_s3_secret_access_key
S3_BUCKET_NAME=your_s3_bucket_name

# ==============================================================================
# REDIS CACHE (Upstash Redis)
# ==============================================================================
REDIS_REST_URL=https://your-redis-instance.upstash.io
REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ==============================================================================
# MAIL SERVICE (Spring Mail / SMTP)
# ==============================================================================
SPRING_MAIL_USERNAME=your_email@gmail.com
# Google App Password (16 characters, not personal account password)
SPRING_MAIL_PASSWORD=your_google_app_password

# ==============================================================================
# SECURITY & AUTHENTICATION (JWT)
# ==============================================================================
# Base64 or 256-bit+ secure random secret
JWT_SECRET=your_jwt_secret_key_at_least_256_bits_long
# Token expiration time in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# ==============================================================================
# MESSAGE BROKER (Aiven Kafka - SASL_SSL)
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=your_kafka_host:port
KAFKA_SASL_USERNAME=your_kafka_username
KAFKA_SASL_PASSWORD=your_kafka_password
KAFKA_CA_CERT_PATH=fintech/ca.pem
KAFKA_PAYLOAD_SECRET_KEY=your_base64_kafka_payload_encryption_key

# ==============================================================================
# FACEID & EKYC SERVICE
# ==============================================================================
FACEID_ENABLED=true
# Threshold in VND (e.g. 10,000,000 VND)
FACEID_HIGH_VALUE_THRESHOLD=10000000

# ==============================================================================
# CLOUDINARY (Media Storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
